{
    "name": "very-happy-monorepo",
    "private": true,
    "description": "Self-hostable web console, relay server, and CLI for coding agents",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Mereithhh/very-happy.git"
    },
    "homepage": "https://github.com/Mereithhh/very-happy#readme",
    "bugs": "https://github.com/Mereithhh/very-happy/issues",
    "scripts": {
        "cli": "pnpm --filter very-happy-cli cli",
        "release": "node ./scripts/release.cjs",
        "changelog:draft": "node ./scripts/changelog/generate-draft.mjs",
        "test:changelog-draft": "node --test ./scripts/changelog/generate-draft.test.mjs",
        "web": "pnpm --filter @slopus/happy-web-v2 dev",
        "app-logs": "pnpm --filter happy-app-logs start",
        "postinstall": "node ./scripts/postinstall.cjs",
        "env:new": "tsx environments/environments.ts new",
        "env:list": "tsx environments/environments.ts list",
        "env:use": "tsx environments/environments.ts use",
        "env:remove": "tsx environments/environments.ts remove",
        "env:current": "tsx environments/environments.ts current",
        "env:server": "tsx environments/environments.ts run server",
        "env:web": "tsx environments/environments.ts run web",
        "env:ios": "tsx environments/environments.ts run ios",
        "env:android": "tsx environments/environments.ts run android",
        "env:cli": "tsx environments/environments.ts run cli",
        "env:seed": "tsx environments/environments.ts seed",
        "env:up": "tsx environments/environments.ts up",
        "env:up:authenticated": "pnpm env:up --template authenticated-empty",
        "env:down": "tsx environments/environments.ts down",
        "env:tailscale": "tsx environments/environments.ts tailscale"
    },
    "workspaces": {
        "packages": [
            "packages/happy-agent",
            "packages/happy-cli",
            "packages/happy-server",
            "packages/happy-wire",
            "packages/happy-app-logs"
        ]
    },
    "pnpm": {
        "overrides": {
            "@babel/core": "7.29.6",
            "@hono/node-server": "1.19.15",
            "@fastify/ajv-compiler>ajv": "8.20.0",
            "@fastify/ajv-compiler>fast-uri": "3.1.5",
            "@modelcontextprotocol/sdk>ajv": "8.20.0",
            "@prisma/config>deepmerge-ts": "8.0.0",
            "@prisma/config>effect": "3.20.0",
            "ajv>fast-uri": "3.1.5",
            "c12>defu": "6.1.5",
            "express-rate-limit>ip-address": "10.3.1",
            "express>body-parser": "2.3.0",
            "express>qs": "6.15.3",
            "elevenlabs>qs": "6.15.3",
            "fast-json-stringify>fast-uri": "3.1.5",
            "fast-json-stringify>ajv": "8.20.0",
            "whatwg-url": "14.2.0",
            "parse-path": "7.0.3",
            "@types/parse-path": "7.0.3",
            "engine.io": "6.6.9",
            "hono": "4.12.34",
            "http-proxy>follow-redirects": "1.16.0",
            "lodash-es": "4.18.1",
            "micromatch>picomatch": "2.3.2",
            "pkgroll>rollup": "4.62.5",
            "pkgroll>yaml": "2.8.3",
            "vite>rollup": "4.62.5",
            "vite>postcss": "8.5.23",
            "postcss>nanoid": "3.3.18",
            "minio>lodash": "4.18.0",
            "minimatch>brace-expansion": "5.0.9",
            "router>path-to-regexp": "8.4.0",
            "shell-quote": "1.10.0",
            "socket.io-parser": "4.2.7",
            "form-data": "4.0.6",
            "ws": "8.21.3"
        },
        "onlyBuiltDependencies": [
            "@more-tech/react-native-libsodium",
            "@prisma/client",
            "@prisma/engines",
            "@shopify/react-native-skia",
            "@tailwindcss/oxide",
            "better-sqlite3",
            "electron",
            "esbuild",
            "node-pty",
            "prisma",
            "sharp"
        ]
    },
    "packageManager": "pnpm@10.11.0"
}
