{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Very Happy projects",
  "uid": "very-happy-projects",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "tags": [
    "very-happy",
    "projects",
    "B-651"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "① Dispatches by entry",
      "description": "Sessions created or moved, by where they started and whether they landed in a project (web-reported; counts only).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (entry, in_project) (increase(project_dispatch_total[$__range]))",
          "legendFormat": "{{entry}} · project={{in_project}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "② 等你处理 → opened (P50 / P90)",
      "description": "Time a session waited for the owner before it was opened (web-reported, once per waiting episode).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, in_project) (rate(attention_open_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P50 · project={{in_project}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (le, in_project) (rate(attention_open_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P90 · project={{in_project}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "③ Session-to-session messages",
      "description": "Peer messages written into sessions; each starts or queues a turn. Token share: scripts/dev/project-metrics.mjs (target ≤10%).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (in_project) (rate(session_peer_messages_total[$__rate_interval]))",
          "legendFormat": "project={{in_project}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "④ project_context reads vs digests",
      "description": "Reads of project context (first-turn prefix + tool) and next-turn digests; non-empty digests = turns that carried a change.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(project_ops_total{op=\"context_read\"}[$__rate_interval]))",
          "legendFormat": "context reads"
        },
        {
          "refId": "B",
          "expr": "sum(rate(project_ops_total{op=\"digest_read\"}[$__rate_interval]))",
          "legendFormat": "digests"
        },
        {
          "refId": "C",
          "expr": "sum(rate(project_ops_total{op=\"digest_nonempty\"}[$__rate_interval]))",
          "legendFormat": "non-empty digests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Project notes and refusals",
      "description": "Agent vs user notes, quota refusals (each refusal returns a one-line alternative), revocations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op, actor) (rate(project_ops_total{op=~\"note_create|note_quota_refused|note_revoke\"}[$__rate_interval]))",
          "legendFormat": "{{op}} · {{actor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Offline messages",
      "description": "Stored for a session that was not running vs delivered at its next turn.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(project_ops_total{op=~\"message_stored|message_delivered\"}[$__rate_interval]))",
          "legendFormat": "{{op}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}