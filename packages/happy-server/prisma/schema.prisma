// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["metrics", "relationJoins", "driverAdapters"]
}

generator json {
    provider = "prisma-json-types-generator"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

//
// Account
//

model Account {
    id              String      @id @default(cuid())
    publicKey       String      @unique
    seq             Int         @default(0)
    feedSeq         BigInt      @default(0)
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt
    settings        String?
    settingsVersion Int         @default(0)
    messageCount    BigInt      @default(0)
    messageBytes    BigInt      @default(0)
    githubUserId    String?     @unique
    githubUser      GithubUser? @relation(fields: [githubUserId], references: [id])

    // Profile
    firstName String?
    lastName  String?
    username  String? @unique
    /// [ImageRef]
    avatar    Json?
    /// B-619: libsodium box public key of the content key pair (base64), uploaded by
    /// the web client so a session DEK can be re-wrapped for this account even when
    /// its master secret is not server-held (QR-paired accounts).
    contentPublicKey String?

    Session             Session[]
    AccountPushToken    AccountPushToken[]
    TerminalAuthRequest TerminalAuthRequest[]
    AccountAuthRequest  AccountAuthRequest[]
    UsageReport         UsageReport[]
    Machine             Machine[]
    UploadedFile        UploadedFile[]
    ServiceAccountToken ServiceAccountToken[]
    RelationshipsFrom   UserRelationship[]    @relation("RelationshipsFrom")
    RelationshipsTo     UserRelationship[]    @relation("RelationshipsTo")
    Artifact            Artifact[]
    AccessKey           AccessKey[]
    UserFeedItem        UserFeedItem[]
    UserKVStore         UserKVStore[]
    VoiceConversation   VoiceConversation[]
    AccountUnlock       AccountUnlock?
    AccountCredential   AccountCredential?
    AccountSecret       AccountSecret?
    AccountIdentity     AccountIdentity[]
    AccountLoginSession AccountLoginSession[]
    Automation          Automation[]
    AgentTeams AgentTeam[]
    Projects   Project[]
    SessionGrantsReceived SessionGrant[] @relation("SessionGrantGrantee")
    SessionGrantsGiven    SessionGrant[] @relation("SessionGrantGrantedBy")
    SessionShareLinks     SessionShareLink[]
}

model AccountCredential {
    username     String   @id
    accountId    String   @unique
    account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    passwordHash String
    secretEnc    String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

model AccountSecret {
    accountId String   @id
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    secretEnc String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model AccountIdentity {
    id              String   @id @default(cuid())
    accountId       String
    account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    provider        String
    providerSubject String
    email           String?
    profile         Json?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@unique([provider, providerSubject])
    @@index([accountId])
    // Database partial unique indexes enforce one Email and one Google
    // identity per account. Prisma cannot express their provider predicates;
    // migrations 20260825173000 and 20260825190000 are the constraint source.
}

model AccountLoginSession {
    id         String    @id
    accountId  String
    account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    tokenHash  String    @unique
    expiresAt  DateTime
    revokedAt  DateTime?
    lastUsedAt DateTime  @default(now())
    createdAt  DateTime  @default(now())

    @@index([accountId, revokedAt, expiresAt])
}

model SignupCapacity {
    id        Int      @id
    updatedAt DateTime @updatedAt
}

model GoogleLoginChallenge {
    nonceHash  String    @id
    expiresAt  DateTime
    consumedAt DateTime?
    createdAt  DateTime  @default(now())

    @@index([expiresAt])
}

/// B-620: one pending generic-OIDC authorization round trip (authorization code +
/// PKCE). The state is the lookup key; the code verifier is stored encrypted under
/// the server master key so a database read alone cannot finish the exchange.
model OidcLoginChallenge {
    id              String   @id
    stateHash       String   @unique
    nonceHash       String
    codeVerifierEnc String
    redirectUri     String
    inviteCode      String?
    /// B-627: encrypted relay-migration handoff carried through the SSO round trip.
    migrationHandoffEnc String?
    expiresAt       DateTime
    createdAt       DateTime @default(now())

    @@index([expiresAt])
}

/// B-627: relay-migration handoff nonces already spent on this relay.
model MigrationHandoffUse {
    nonce     String   @id
    expiresAt DateTime
    usedAt    DateTime @default(now())

    @@index([expiresAt])
}

/// B-620: one-time handoff from the OIDC callback redirect to the Web client.
/// The browser receives only an opaque code; the login token and account secret
/// stay server-side (encrypted) until `POST /v1/auth/oidc/complete` consumes it.
model OidcLoginHandoff {
    codeHash   String   @id
    payloadEnc String
    expiresAt  DateTime
    createdAt  DateTime @default(now())

    @@index([expiresAt])
}

model EmailLoginChallenge {
    id         String    @id
    email      String
    codeHash   String
    expiresAt  DateTime
    consumedAt DateTime?
    attempts   Int       @default(0)
    createdAt  DateTime  @default(now())

    @@index([email, expiresAt])
    @@index([expiresAt])
}

model AuthRateLimitBucket {
    key       String   @id
    count     Int
    resetAt   DateTime
    updatedAt DateTime @updatedAt

    @@index([resetAt])
}

model AccountUnlock {
    accountId String   @id
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    /// [PasswordBlob]
    blob      Json
    updatedAt DateTime @updatedAt
}

model TerminalAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    supportsV2        Boolean  @default(false)
    claimSecretHash   String?
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model AccountAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    claimSecretHash   String?
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model AccountPushToken {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, token])
}

//
// Sessions
//

model Session {
    id                String           @id @default(cuid())
    tag               String
    accountId         String
    account           Account          @relation(fields: [accountId], references: [id])
    metadata          String
    metadataVersion   Int              @default(0)
    agentState        String?
    agentStateVersion Int              @default(0)
    dataEncryptionKey Bytes?
    // B-297 - plaintext, self-reported client identity ("cli-coding-session/0.2.105").
    lastHappyClient   String?
    lastHappyClientAt DateTime?
    seq               Int              @default(0)
    active            Boolean          @default(true)
    archivedAt        DateTime?
    lastActiveAt      DateTime         @default(now())
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt
    messages          SessionMessage[]
    usageReports      UsageReport[]
    accessKeys        AccessKey[]
    promptQueue       SessionPromptQueueItem[]
    grants            SessionGrant[]
    shareLinks        SessionShareLink[]
    projectMember     ProjectMember?

    @@unique([accountId, tag])
    @@index([accountId, updatedAt(sort: Desc)])
    @@index([accountId, archivedAt])
}

model SessionMessage {
    id        String   @id @default(cuid())
    sessionId String
    session   Session  @relation(fields: [sessionId], references: [id])
    localId   String?
    seq       Int
    /// [SessionMessageContent]
    content   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([sessionId, localId])
    @@index([sessionId, seq])
}

/// B-619 session sharing: the owner lets another account on this server read
/// (viewer) or also write (driver) ONE session. `granteeDataEncryptionKey` is
/// the session DEK re-wrapped for the grantee's content public key, so the
/// grantee decrypts the same ciphertext the owner does. A grant starts
/// `pending` and only turns `active` when the grantee accepts.
enum SessionGrantRole {
    viewer
    driver
}

enum SessionGrantStatus {
    pending
    active
    revoked
}

model SessionGrant {
    id                       String             @id @default(cuid())
    sessionId                String
    session                  Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    granteeAccountId         String
    grantee                  Account            @relation("SessionGrantGrantee", fields: [granteeAccountId], references: [id], onDelete: Cascade)
    grantedByAccountId       String
    grantedBy                Account            @relation("SessionGrantGrantedBy", fields: [grantedByAccountId], references: [id], onDelete: Cascade)
    role                     SessionGrantRole
    status                   SessionGrantStatus @default(pending)
    granteeDataEncryptionKey Bytes
    createdAt                DateTime           @default(now())
    updatedAt                DateTime           @updatedAt
    acceptedAt               DateTime?
    revokedAt                DateTime?
    /// B-701: null = no expiry. Every read path treats a past value like revoked.
    expiresAt                DateTime?

    @@unique([sessionId, granteeAccountId])
    @@index([granteeAccountId, status])
}

/// B-701 read-only share link (spec specs/2026-10-session-sharing-tiers.md).
/// Only sha256(secret) is stored; the secret lives in the URL fragment.
model SessionShareLink {
    id                 String                    @id @default(cuid())
    sessionId          String
    session            Session                   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    createdByAccountId String
    createdBy          Account                   @relation(fields: [createdByAccountId], references: [id], onDelete: Cascade)
    tokenHash          Bytes                     @unique
    /// 'snapshot' (messages up to snapshotSeq) | 'live'
    scope              String
    snapshotSeq        Int?
    snapshotAt         DateTime?
    expiresAt          DateTime?
    revokedAt          DateTime?
    accessCount        Int                       @default(0)
    lastAccessedAt     DateTime?
    createdAt          DateTime                  @default(now())
    updatedAt          DateTime                  @updatedAt
    accesses           SessionShareLinkAccess[]

    @@index([sessionId])
    @@index([createdByAccountId])
}

/// B-701 link opens: one row per viewer per 10 minutes, purged after 90 days.
model SessionShareLinkAccess {
    id              String           @id @default(cuid())
    linkId          String
    link            SessionShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
    at              DateTime         @default(now())
    /// Anonymous by design: a salted IP hash (dedupe only) and a link-preview-bot flag.
    ipHash          Bytes
    bot             Boolean          @default(false)

    @@index([linkId, at])
    @@index([at])
}

/// B-509 server-side prompt queue: prompts queued from a client while the
/// session is busy. `content` is the same opaque encrypted user record a
/// SessionMessage carries; the wrapper dispatches the head item into a
/// SessionMessage with the same localId when it is idle.
model SessionPromptQueueItem {
    id        String   @id @default(cuid())
    sessionId String
    session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    localId   String
    position  Int
    /// [SessionMessageContent]
    content   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([sessionId, localId])
    @@index([sessionId, position])
}

//
// Github
//

model GithubUser {
    id        String    @id
    /// [GitHubProfile]
    profile   Json
    token     Bytes?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    Account   Account[]
}

model GithubOrganization {
    id        String   @id
    /// [GitHubOrg]
    profile   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Utility
//

model GlobalLock {
    key       String   @id @default(cuid())
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    expiresAt DateTime
}

model RepeatKey {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    expiresAt DateTime
}

model SimpleCache {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Usage Reporting
//

model UsageReport {
    id        String   @id @default(cuid())
    key       String
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    sessionId String?
    session   Session? @relation(fields: [sessionId], references: [id])
    /// [UsageReportData]
    data      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, sessionId, key])
    @@index([accountId])
    @@index([sessionId])
}

//
// Machines
//

model Machine {
    id                 String      @id
    accountId          String
    account            Account     @relation(fields: [accountId], references: [id])
    metadata           String // Encrypted - contains static machine info
    metadataVersion    Int         @default(0)
    daemonState        String? // Encrypted - contains dynamic daemon state
    daemonStateVersion Int         @default(0)
    // B-297 - plaintext, self-reported client identity ("cli-daemon/0.2.105").
    // The CLI version also lives inside the encrypted `metadata` blob, which the
    // server never parses; this column is the only SQL-queryable copy.
    lastHappyClient    String?
    lastHappyClientAt  DateTime?
    dataEncryptionKey  Bytes?
    seq                Int         @default(0)
    active             Boolean     @default(true)
    lastActiveAt       DateTime    @default(now())
    createdAt          DateTime    @default(now())
    updatedAt          DateTime    @updatedAt
    accessKeys         AccessKey[]

    @@unique([accountId, id])
    @@index([accountId])
}

model UploadedFile {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    path      String
    width     Int?
    height    Int?
    thumbhash String?
    reuseKey  String?
    size      Int?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, path])
    @@index([accountId])
}

model ServiceAccountToken {
    id         String    @id @default(cuid())
    accountId  String
    account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    vendor     String
    token      Bytes // Encrypted token
    metadata   Json? // Optional vendor metadata
    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    @@unique([accountId, vendor])
    @@index([accountId])
}

//
// Artifacts
//

model Artifact {
    id                String   @id // UUID provided by client
    accountId         String
    account           Account  @relation(fields: [accountId], references: [id])
    header            Bytes // Encrypted header (can contain JSON)
    headerVersion     Int      @default(0)
    body              Bytes // Encrypted body
    bodyVersion       Int      @default(0)
    dataEncryptionKey Bytes // Encryption key for this artifact
    seq               Int      @default(0)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([accountId])
    @@index([accountId, updatedAt(sort: Desc)])
}

//
// Access Keys
//

model AccessKey {
    id          String   @id @default(cuid())
    accountId   String
    account     Account  @relation(fields: [accountId], references: [id])
    machineId   String
    machine     Machine  @relation(fields: [accountId, machineId], references: [accountId, id])
    sessionId   String
    session     Session  @relation(fields: [sessionId], references: [id])
    data        String // Encrypted data
    dataVersion Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([accountId, machineId, sessionId])
    @@index([accountId])
    @@index([sessionId])
    @@index([machineId])
}

//
// Social Network - Relationships
//

enum RelationshipStatus {
    none
    requested
    pending
    friend
    rejected
}

model UserRelationship {
    fromUserId     String
    fromUser       Account            @relation("RelationshipsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
    toUserId       String
    toUser         Account            @relation("RelationshipsTo", fields: [toUserId], references: [id], onDelete: Cascade)
    status         RelationshipStatus @default(pending)
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt
    acceptedAt     DateTime?
    lastNotifiedAt DateTime?

    @@id([fromUserId, toUserId])
    @@index([toUserId, status])
    @@index([fromUserId, status])
}

//
// Feed
//

model UserFeedItem {
    id        String   @id @default(cuid())
    userId    String
    user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
    counter   BigInt
    repeatKey String?
    /// [FeedBody]
    body      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, counter])
    @@unique([userId, repeatKey])
    @@index([userId, counter(sort: Desc)])
}

//
// Key-Value Storage
//

model UserKVStore {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    key       String   // Unencrypted for indexing
    value     Bytes?   // Encrypted value, null when "deleted"
    version   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, key])
    @@index([accountId])
}

//
// Voice Conversations — tracks ElevenLabs conversations per user for rate limiting
//

model VoiceConversation {
    id                         String   @id @default(cuid())
    accountId                  String
    account                    Account  @relation(fields: [accountId], references: [id])
    elevenLabsConversationId   String   @unique
    durationSecs               Int?     // Filled in lazily from ElevenLabs API
    createdAt                  DateTime @default(now())

    @@index([accountId, createdAt(sort: Desc)])
}

model AgentTeam {
    id String @id
    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    credentials TeamAgentCredential[]
    requests TeamRequest[]
    operations TeamOperation[]
    messages TeamMessage[]
    accountId String
    machineId String
    version Int @default(0)
    state Json
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
    /// B-644: project this team is attached to (1 project : N teams). Set only via `attach-team`.
    projectId String?
    project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
    @@index([accountId, machineId])
    @@index([projectId])
}

model TeamAgentCredential {
    id String @id
    teamId String
    team AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
    botId String
    generation Int
    tokenHash String @unique
    tokenEnc String
    expiresAt DateTime
    revokedAt DateTime?
    createdAt DateTime @default(now())
    @@index([teamId, botId])
}

model TeamRequest {
    teamId String
    team AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
    requestId String
    actorKey String
    requestHash String
    response Json
    createdAt DateTime @default(now())
    @@id([teamId, requestId])
}

model TeamOperation {
    id String @id
    teamId String
    team AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
    state Json
    createdAt DateTime @default(now())
    @@index([teamId])
}

model TeamMessage {
    id String @id
    teamId String
    team AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
    state Json
    createdAt DateTime @default(now())
    @@index([teamId])
}

//
// Automations (B-496): account-level scheduled / triggered runs.
//

model Automation {
    id            String          @id
    accountId     String
    account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
    name          String
    description   String?
    machineId     String
    status        String          @default("active")
    /// [AutomationTrigger]
    trigger       Json
    /// [AutomationAction]
    action        Json
    concurrency   String          @default("skip")
    maxRuntimeMs  Int
    nextRunAt     DateTime?
    version       Int             @default(1)
    lastRunAt     DateTime?
    lastRunStatus String?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @default(now())
    runs          AutomationRun[]
    stickies      AutomationSticky[]
    /// B-644: sessions this automation spawns join this project.
    projectId     String?
    project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
    @@unique([accountId, name])
    @@index([accountId, machineId, status, nextRunAt])
}

model AutomationRun {
    id              String     @id
    automationId    String
    automation      Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
    accountId       String
    machineId       String
    source          String
    dedupeKey       String?
    /// Holds `dedupeKey` while the run occupies the 24h idempotency slot (queued runs only; cleared when the window expires).
    dedupeSlot      String?
    payload         String?
    status          String     @default("queued")
    needsAttention  Boolean    @default(false)
    attentionReason String?
    /// B-508: when needsAttention last became true / was cleared, and by what (AutomationAckBy vocabulary).
    attentionAt     DateTime?
    ackedAt         DateTime?
    ackedBy         String?
    offlineFlaggedAt DateTime?
    claimId         String?
    sessionId       String?
    stickyKey       String?
    scheduledFor    DateTime?
    claimedAt       DateTime?
    leaseUntil      DateTime?
    startedAt       DateTime?
    finishedAt      DateTime?
    summary         String?
    error           String?
    exitCode        Int?
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @default(now())
    @@index([automationId, createdAt])
    @@index([accountId, machineId, status])
    @@index([accountId, needsAttention])
    @@index([automationId, dedupeKey])
    @@unique([automationId, dedupeSlot])
}

/// Last successful claim per (account, machine): the daemon liveness signal used for `machine_offline` attention.
model AutomationClaimCursor {
    accountId   String
    machineId   String
    lastClaimAt DateTime
    @@id([accountId, machineId])
}

model AutomationSticky {
    automationId String
    automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
    key          String
    sessionId    String
    updatedAt    DateTime   @default(now())
    @@id([automationId, key])
}

//
// Projects (B-644, specs/2026-10-projects.md): account-owned long-lived work
// containers. Plaintext server-side (same trust tier as Teams).
//

model Project {
    id                     String    @id
    accountId              String
    account                Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    name                   String
    goal                   String?
    instructions           String    @default("")
    instructionsVersion    Int       @default(0)
    instructionsUpdatedBy  String?
    instructionsUpdatedAt  DateTime?
    instructionsSummary    String?
    /// [ProjectFolders]
    folders                Json      @default("[]")
    /// [ProjectDefaults]
    defaults               Json      @default("{}")
    /// Monotonic counter behind `ProjectLogEntry.seq` ("#12").
    logSeq                 Int       @default(0)
    /// Idempotency key of the create request (hash of accountId + requestId).
    requestKey             String?   @unique
    archivedAt             DateTime?
    createdAt              DateTime  @default(now())
    updatedAt              DateTime  @default(now())
    members                ProjectMember[]
    revisions              ProjectInstructionsRevision[]
    log                    ProjectLogEntry[]
    presence               ProjectPresence[]
    messages               ProjectMessage[]
    teams                  AgentTeam[]
    automations            Automation[]
    @@index([accountId, archivedAt])
}

model ProjectInstructionsRevision {
    projectId    String
    project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    version      Int
    instructions String
    updatedBy    String?
    summary      String?
    createdAt    DateTime @default(now())
    @@id([projectId, version])
}

/// Explicit membership. Each session belongs to at most one project (`sessionId` unique).
/// Team-derived members are computed at read time and never stored here.
model ProjectMember {
    id        String   @id
    projectId String
    project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    sessionId String   @unique
    session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    accountId String
    /// Self-reported by the daemon through presence writes.
    machineId String?
    via       String   @default("explicit")
    createdAt DateTime @default(now())
    @@index([projectId])
    @@index([accountId])
}

model ProjectLogEntry {
    id              String    @id
    projectId       String
    project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
    seq             Int
    kind            String
    title           String
    body            String    @default("")
    authorSessionId String?
    authorUser      Boolean   @default(false)
    supersedes      String?
    revokedAt       DateTime?
    createdAt       DateTime  @default(now())
    @@unique([projectId, seq])
    @@index([projectId, createdAt])
    @@index([authorSessionId, createdAt])
}

/// Written by the daemon (the server cannot read encrypted session metadata).
model ProjectPresence {
    sessionId                   String   @id
    projectId                   String
    project                     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    accountId                   String
    machineId                   String
    title                       String?
    agent                       String?
    machine                     String?
    branch                      String?
    state                       String?
    doing                       String?
    injectedInstructionsVersion Int?
    /// [ProjectCapabilities]
    capabilities                Json     @default("[]")
    updatedAt                   DateTime @default(now())
    @@index([projectId])
    @@index([accountId])
}

/// Offline peer message inside one project. Body erased 7 days after delivery.
model ProjectMessage {
    id            String    @id
    projectId     String
    project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
    accountId     String
    fromSessionId String
    toSessionId   String
    body          String?
    deliveredAt   DateTime?
    createdAt     DateTime  @default(now())
    @@index([toSessionId, deliveredAt])
    @@index([projectId, createdAt])
}

/// Per-session "since last read" cursor for `project_context`.
model ProjectReadCursor {
    sessionId String   @id
    projectId String
    readAt    DateTime
}
