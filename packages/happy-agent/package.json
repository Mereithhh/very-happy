{
  "name": "happy-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Internal monorepo control-plane prototype; not a published Very Happy package",
  "author": "Kirill Dubovitskiy",
  "contributors": [
    "Mereith (very-happy fork)"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Mereithhh/very-happy/tree/main/packages/happy-agent",
  "bugs": "https://github.com/Mereithhh/very-happy/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mereithhh/very-happy.git",
    "directory": "packages/happy-agent"
  },
  "bin": {
    "happy-agent": "./bin/happy-agent.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --noEmit && pkgroll",
    "test": "$npm_execpath run build && vitest run",
    "test:integration": "$npm_execpath run build && vitest run --config vitest.integration.config.ts",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "node -e \"throw new Error('happy-agent is private and must not be published')\""
  },
  "dependencies": {
    "@slopus/happy-wire": "workspace:*",
    "axios": "^1.16.0",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io-client": "^4.8.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "@types/qrcode-terminal": "^0.12.2",
    "pkgroll": "^2.14.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@10.11.0"
}
