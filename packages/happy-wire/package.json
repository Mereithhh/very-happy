{
  "name": "@slopus/happy-wire",
  "private": true,
  "version": "0.1.0",
  "description": "Shared message wire types and Zod schemas for Happy clients and services",
  "author": "Kirill Dubovitskiy",
  "contributors": [
    "Mereith (very-happy fork)"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Mereithhh/very-happy/tree/main/packages/happy-wire",
  "bugs": "https://github.com/Mereithhh/very-happy/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mereithhh/very-happy.git",
    "directory": "packages/happy-wire"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --noEmit && pkgroll",
    "test": "$npm_execpath run build && vitest run",
    "prepublishOnly": "node -e \"throw new Error('@slopus/happy-wire is an internal workspace package and must not be published')\""
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "pkgroll": "^2.14.2",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@10.11.0"
}
